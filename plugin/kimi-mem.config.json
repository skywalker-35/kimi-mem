{
  "port": 5757,
  "inject": {
    "enabled": true,
    "maxResults": 5,
    "minPromptLength": 8
  },
  "capture": {
    "enabled": true,
    "minIntervalSec": 120,
    "provider": "openai-chat",
    "apiUrl": "https://api.openai.com/v1",
    "apiKeyEnv": "OPENAI_API_KEY",
    "model": "<你的模型名，如 gpt-5.3-instant / deepseek-v4-flash / ep-xxxx>",
    "extraParams": {
      "reasoning_effort": "low"
    },
    "maxContextBytes": 60000,
    "notify": true
  },
  "profile": {
    "enabled": true,
    "analysisInterval": 10
  }
}
